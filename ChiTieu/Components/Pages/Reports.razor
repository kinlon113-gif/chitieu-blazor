@page "/reports"
@attribute [Authorize]
@inject GroupService GroupService
@inject TransactionService TxService
@inject AuthenticationStateProvider AuthState
@using ChiTieu.Services
@using Microsoft.AspNetCore.Authorization

<PageTitle>Báo cáo - Chi Tiêu</PageTitle>

<div class="fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Báo cáo</h1>
            <div class="page-sub">Tổng hợp thu chi theo tháng</div>
        </div>
        <input class="input" style="width:170px" type="month" value="@MonthKey" @onchange="OnMonthChanged" />
    </div>

    @if (ActiveGroup == null)
    {
        <EmptyGroup />
    }
    else
    {
        <div class="grid-4" style="margin-bottom:20px">
            <div class="stat-card"><div class="stat-label">Thu</div><div class="stat-value positive">+@Money(Income)</div></div>
            <div class="stat-card"><div class="stat-label">Chi</div><div class="stat-value negative">-@Money(Expense)</div></div>
            <div class="stat-card"><div class="stat-label">Số dư</div><div class="stat-value @(Income - Expense >= 0 ? "positive" : "negative")">@Money(Income - Expense)</div></div>
            <div class="stat-card"><div class="stat-label">Giao dịch</div><div class="stat-value">@Transactions.Count</div></div>
        </div>

        <div class="dashboard-grid">
            <div class="card panel">
                <div class="card-header"><h2 class="card-title">Chi theo danh mục</h2></div>
                @foreach (var item in ByCategory.OrderByDescending(x => x.Value))
                {
                    var percent = Expense > 0 ? Math.Min(100, (int)(item.Value / Expense * 100)) : 0;
                    <div class="bar-row">
                        <div class="bar-top"><span>@Label(item.Key)</span><strong>@Money(item.Value)</strong></div>
                        <div class="bar-track"><div class="bar-fill" style="width:@percent%"></div></div>
                    </div>
                }
            </div>
            <div class="card panel">
                <div class="card-header"><h2 class="card-title">Chi theo thành viên</h2></div>
                @foreach (var item in ByMember.OrderByDescending(x => x.Value))
                {
                    var percent = Expense > 0 ? Math.Min(100, (int)(item.Value / Expense * 100)) : 0;
                    <div class="bar-row">
                        <div class="bar-top"><span>@item.Key</span><strong>@Money(item.Value)</strong></div>
                        <div class="bar-track"><div class="bar-fill alt-fill" style="width:@percent%"></div></div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private Group? ActiveGroup;
    private List<Transaction> Transactions = new();
    private Dictionary<string, decimal> ByCategory = new();
    private Dictionary<string, decimal> ByMember = new();
    private decimal Income, Expense;
    private string UserId = "";
    private string MonthKey = DateTime.Now.ToString("yyyy-MM");

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        UserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        ActiveGroup = (await GroupService.GetUserGroupsAsync(UserId)).FirstOrDefault();
        await LoadAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        MonthKey = e.Value?.ToString() ?? DateTime.Now.ToString("yyyy-MM");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ActiveGroup == null) return;
        Transactions = await TxService.GetByGroupMonthAsync(ActiveGroup.Id, MonthKey);
        Income = Transactions.Where(t => t.Type == "income").Sum(t => t.Amount);
        Expense = Transactions.Where(t => t.Type == "expense").Sum(t => t.Amount);
        ByCategory = await TxService.GetExpenseByCategoryAsync(ActiveGroup.Id, MonthKey);
        ByMember = await TxService.GetExpenseByMemberAsync(ActiveGroup.Id, MonthKey);
    }

    private static string Money(decimal value) => $"{value:N0}đ";
    private static string Label(string id) => id switch
    {
        "food" => "Ăn uống", "transport" => "Di chuyển", "rent" => "Tiền nhà",
        "utilities" => "Điện nước", "internet" => "Internet", "supermarket" => "Siêu thị",
        "shopping" => "Mua sắm", "entertainment" => "Giải trí", "health" => "Y tế",
        "education" => "Học tập", "travel" => "Du lịch", _ => "Khác",
    };
}

