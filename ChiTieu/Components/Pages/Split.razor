@page "/split"
@attribute [Authorize]
@inject GroupService GroupService
@inject SplitBillService SplitBillService
@inject AuthenticationStateProvider AuthState
@using ChiTieu.Services
@using Microsoft.AspNetCore.Authorization

<PageTitle>Chia tiền - Chi Tiêu</PageTitle>

<div class="fade-in">
    <div class="page-header">
        <div>
            <h1 class="page-title">Chia tiền</h1>
            <div class="page-sub">Tạo khoản chia đều và tự động ghi nhận công nợ</div>
        </div>
    </div>

    @if (ActiveGroup == null)
    {
        <EmptyGroup />
    }
    else
    {
        <div class="card panel" style="margin-bottom:16px">
            <div class="quick-form">
                <input class="input" placeholder="Mô tả, ví dụ: ăn tối" @bind="Description" />
                <input class="input" placeholder="Tổng tiền, ví dụ 800k" @bind="AmountText" />
                <button class="btn btn-primary" @onclick="CreateSplit" disabled="@Saving">Chia đều</button>
            </div>
            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="alert @(IsError ? "alert-danger" : "alert-success")" style="margin-top:12px">@Message</div>
            }
        </div>

        @if (!Splits.Any())
        {
            <div class="empty-state card"><div>✂️</div><h3>Chưa có khoản chia</h3><p>Nhập tổng tiền để chia đều cho tất cả thành viên nhóm.</p></div>
        }
        else
        {
            <div class="card" style="overflow:hidden">
                @foreach (var bill in Splits)
                {
                    <div class="tx-row">
                        <div class="tx-icon">✂️</div>
                        <div class="tx-info">
                            <div class="tx-note">@bill.Description</div>
                            <div class="tx-meta">@bill.Date.ToString("dd/MM/yyyy") · @bill.Items.Count người</div>
                        </div>
                        <div class="tx-amount">@Money(bill.TotalAmount)</div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private Group? ActiveGroup;
    private List<SplitBill> Splits = new();
    private string UserId = "";
    private string Description = "";
    private string AmountText = "";
    private string Message = "";
    private bool IsError;
    private bool Saving;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        UserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        ActiveGroup = (await GroupService.GetUserGroupsAsync(UserId)).FirstOrDefault();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ActiveGroup == null) return;
        Splits = await SplitBillService.GetGroupSplitsAsync(ActiveGroup.Id);
    }

    private async Task CreateSplit()
    {
        Message = "";
        if (ActiveGroup == null) return;
        var amount = ParseAmount(AmountText);
        var members = ActiveGroup.Members.Select(m => m.UserId).Distinct().ToList();
        if (amount <= 0 || members.Count == 0)
        {
            Message = "Số tiền hoặc thành viên chưa hợp lệ.";
            IsError = true;
            return;
        }

        Saving = true;
        await SplitBillService.SplitEquallyAsync(ActiveGroup.Id, UserId, amount, string.IsNullOrWhiteSpace(Description) ? "Khoản chia mới" : Description.Trim(), members);
        AmountText = "";
        Description = "";
        Message = "Đã tạo khoản chia.";
        IsError = false;
        Saving = false;
        await LoadAsync();
    }

    private static string Money(decimal value) => $"{value:N0}đ";
    private static decimal ParseAmount(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return 0;
        var normalized = input.Trim().ToLowerInvariant().Replace("vnd", "").Replace("đ", "").Replace(",", "").Replace(" ", "");
        var multiplier = 1m;
        if (normalized.EndsWith("k")) { multiplier = 1_000m; normalized = normalized[..^1]; }
        else if (normalized.EndsWith("m")) { multiplier = 1_000_000m; normalized = normalized[..^1]; }
        return decimal.TryParse(normalized, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var value) ? value * multiplier : 0;
    }
}

